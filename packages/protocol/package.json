{
  "name": "@pearcoderhq/protocol",
  "version": "0.3.0",
  "private": true,
  "description": "Pearcoder collaboration protocol: event envelope, event types and schemas.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pearcoderhq/pearcoder.git",
