{
  "name": "pearcoder-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check . && depcruise packages --config .dependency-cruiser.cjs",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "changeset": "changeset",
    "test:e2e": "pnpm build && pnpm --filter @pearcoderhq/e2e test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@changesets/cli": "3.0.3",
    "@swc/core": "^1.16.20",
    "@types/node": "^24",
    "dependency-cruiser": "18.7.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
